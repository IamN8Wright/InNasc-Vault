{
  "name": "innasc-vault-local",
  "version": "0.1.0-alpha.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names UI,API --prefix-colors cyan,green \"npm:dev:ui\" \"npm:dev:api\"",
    "dev:ui": "vinext dev --port 3000",
    "dev:api": "tsx watch server/index.ts",
    "build": "vinext build && npm run build:api",
    "build:api": "tsc -p server/tsconfig.json && node scripts/copy-server-assets.mjs",
    "start": "concurrently --kill-others --names UI,API --prefix-colors cyan,green \"npm:start:ui\" \"npm:start:api\"",
    "start:ui": "vinext start --port 3000 --hostname 127.0.0.1",
    "start:api": "node dist/local-server/index.js",
    "start:railway": "vinext start",
    "check": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit && npm run lint",
    "test": "npm run build:api && node tests/email-provider-smoke.mjs && node tests/api-smoke.mjs",
    "test:railway": "npm run build && node tests/railway-smoke.mjs",
    "lint": "oxlint app lib server",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@shadcn/react": "0.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cors": "^2.8.6",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "input-otp": "1.4.2",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "1.31.0",
    "nodemailer": "^9.1.0",
    "notosans-fontface": "^1.3.0",
    "otplib": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "concurrently": "^10.0.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
